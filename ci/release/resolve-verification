#!/usr/bin/env bash
# Decides whether the release pull request's checks already verified the merged commit, so that
# publication does not run the whole of ci/verify a second time. Looks through this repository's
# successful Verify runs for the pull request's last head, newest first, for one whose
# `release-packages` manifest names this version and the very tree that was merged.
#
#   GH_TOKEN            a token that may read this repository's Actions artifacts
#   GITHUB_REPOSITORY   owner/name
#   HEAD_SHA            the release pull request's last head
#   MERGE_SHA           the commit the merge made on the default branch
#   RELEASE_VERSION     the version being released
#
# A successful Verify run is one where the Gradle build passed on Linux, the Apple targets on macOS,
# and `Build release artifacts` built every package, all on one checkout — the pull request merged
# into its base as it stood then. Its manifest records that checkout's tree; if the merged commit
# has the same tree, the source was verified in full.
#
# Writes `verified` — `true`, or `false` when nothing qualifies: the pull request skipped its checks,
# its artifacts expired, or the default branch moved after they ran. Publication then verifies the
# merged commit itself. Finding nothing is never a failure.
source "$(dirname "$0")/common.sh"

repository="${GITHUB_REPOSITORY:?GITHUB_REPOSITORY is required}"
version="${RELEASE_VERSION:?RELEASE_VERSION is required}"
merged_tree="$(git rev-parse "${MERGE_SHA:?MERGE_SHA is required}^{tree}")"

download="$(mktemp -d)"
trap 'rm -rf "$download"' EXIT

# Only runs of this repository's own branches: a fork's pull request runs the same workflow, and its
# artifacts are whatever the fork's code chose to write.
runs="$(gh api "repos/$repository/actions/workflows/verify.yml/runs?head_sha=${HEAD_SHA:?HEAD_SHA is required}&event=pull_request&status=success&per_page=50" \
    --jq ".workflow_runs | sort_by(.created_at) | reverse | .[] | select(.head_repository.full_name == \"$repository\") | .id")"

for run in $runs; do
    artifact="$(gh api "repos/$repository/actions/runs/$run/artifacts" \
        --jq '.artifacts[] | select(.name == "release-packages" and .expired == false) | .id')"
    if [ -z "$artifact" ]; then
        echo "Verify run $run kept no release packages"
        continue
    fi

    rm -rf "${download:?}"/*
    gh run download "$run" --repo "$repository" --name release-packages --dir "$download"
    manifest="$download/manifest"
    [ -f "$manifest" ] || { echo "Verify run $run kept no manifest"; continue; }

    built_version="$(awk '$1 == "version" { print $2 }' "$manifest")"
    built_tree="$(awk '$1 == "tree" { print $2 }' "$manifest")"
    if [ "$built_version" = "$version" ] && [ "$built_tree" = "$merged_tree" ]; then
        echo "::notice::Verify run $run verified tree $merged_tree at $version; not verifying it again"
        output verified true
        output source "https://github.com/$repository/actions/runs/$run"
        exit 0
    fi
    echo "Verify run $run checked $built_version at tree $built_tree, not $version at $merged_tree"
done

echo "::notice::No check of the release pull request covers the merged commit; verifying it here"
output verified false
