<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logging for the reference host, and the demonstration of what the module's SyncLog port buys.

  The synchronisation module depends on no logging library. It reports through a port, Slf4jSyncLog
  turns those records into SLF4J calls under `dev.voir.reflector.sync.<source>`, and from here on
  the levels in effect are a matter of this file — externally, per area, and changeable at runtime
  through logback's own JMX or scan settings without redeploying the server.

  The last two lines are the case this was built for: run production at INFO, and turn just the
  module's push path verbose while investigating slow writes. Doing that with one level for
  everything is not practical on a server, because the read paths outnumber the writes by orders of
  magnitude and would bury them.
-->
<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>

    <!-- Everything the module has to say, at the levels a running server can afford to leave on:
         a commit listener that threw, a counter lock held long enough to be a queue, a cursor
         refused because the retention window is too short for this population. -->
    <logger name="dev.voir.reflector.sync" level="INFO"/>

    <!-- Uncomment to follow every group the module applies, refuses or answers from a stored
         result, while the rest of the server stays quiet. -->
    <!-- <logger name="dev.voir.reflector.sync.push" level="DEBUG"/> -->
</configuration>
